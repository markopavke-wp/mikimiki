# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local / heavy artifacts
.venv-glb/
.tmp-previews/
scripts/frame-generator/**/*.mp4
scripts/frame-generator/tripo-cache/
scripts/frame-generator/motion-check/
scripts/frame-generator/keyframes/
scripts/frame-generator/nolith-refs/
public/frames-nolith-backup/
public/frames-prev-backup/
public/frames-miki-backup/
*.pyc
__pycache__/
